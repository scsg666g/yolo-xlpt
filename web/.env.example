# Target workspace and training runtime
PLATFORM_INSTANCE_NAME=local
YOLO_PROJECT_ROOT=.
ULTRALYTICS_ROOT=ultralytics
YOLO_BIN=/data/conda/envs/yolo/bin/yolo
PLATFORM_MKL_THREADING_LAYER=GNU
# Optional. Leave as nvidia-smi when it is available through PATH.
NVIDIA_SMI_BIN=nvidia-smi

# Platform-owned state and training output
PLATFORM_DATA_ROOT=web/data
PLATFORM_RUNS_ROOT=web/data/runs
PLATFORM_RUNTIME_ROOT=web/data/task_runtime
DATABASE_URL=sqlite:///web/data/platform.db

# Standalone local model-test roots, separated by the operating-system path
# separator. Relative values resolve from YOLO_PROJECT_ROOT; pt is the default.
PLATFORM_MODEL_TEST_ROOTS=pt

# Persistent model-test history capacity. Values are bytes; set a quota or
# minimum-free setting to 0 only when that protection is intentionally disabled.
PLATFORM_MODEL_TEST_HISTORY_QUOTA_BYTES=21474836480
PLATFORM_MODEL_TEST_TASK_QUOTA_BYTES=5368709120
PLATFORM_MODEL_TEST_MIN_FREE_BYTES=2147483648
PLATFORM_MODEL_TEST_IMAGE_RESERVE_BYTES=67108864

# Immutable standalone models fetched from remote Agents. These bytes are
# separate from model-test history and therefore have a separate total quota.
PLATFORM_REMOTE_MODEL_CACHE_QUOTA_BYTES=21474836480
PLATFORM_REMOTE_MODEL_CACHE_MIN_FREE_BYTES=2147483648
