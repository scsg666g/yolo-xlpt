# Target workspace and training runtime
YOLO_PROJECT_ROOT=/data/yolo-模型训练平台开发/yolo
ULTRALYTICS_ROOT=/data/yolo-模型训练平台开发/yolo/ultralytics
YOLO_BIN=/data/conda/envs/yolo/bin/yolo
PLATFORM_MKL_THREADING_LAYER=GNU
# Optional. Leave as nvidia-smi when it is available through PATH.
NVIDIA_SMI_BIN=nvidia-smi

# Platform-owned state and training output
PLATFORM_DATA_ROOT=/data/yolo-模型训练平台开发/yolo/web/data
PLATFORM_RUNS_ROOT=/data/yolo-模型训练平台开发/yolo/web/data/runs
PLATFORM_RUNTIME_ROOT=/data/yolo-模型训练平台开发/yolo/web/data/task_runtime
DATABASE_URL=sqlite:////data/yolo-模型训练平台开发/yolo/web/data/platform.db
